# Shared palette and classes for every architecture diagram.
vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 1
    pad: 48
  }
}

classes: {
  source: {style: {fill: "#E6F4FA"; stroke: "#2A8FB8"; stroke-width: 2; border-radius: 10; font-color: "#0F3D52"}}
  prepare: {style: {fill: "#E8F0FE"; stroke: "#3B6FD8"; stroke-width: 2; border-radius: 10; font-color: "#13306B"}}
  lang: {style: {fill: "#F1E8FD"; stroke: "#8A4FD8"; stroke-width: 2; border-radius: 10; font-color: "#3D1A6E"}}
  extract: {style: {fill: "#FDEDE6"; stroke: "#D8673B"; stroke-width: 2; border-radius: 10; font-color: "#6B2A0E"}}
  quality: {style: {fill: "#E3F5EC"; stroke: "#1F9D6B"; stroke-width: 2; border-radius: 10; font-color: "#0B4A31"}}
  gate: {style: {fill: "#ECEDF1"; stroke: "#4A4A55"; stroke-width: 2; border-radius: 10; font-color: "#1D1D24"}}
  governor: {style: {fill: "#FFF6DB"; stroke: "#B8860B"; stroke-width: 2; border-radius: 10; font-color: "#5C4300"}}
  retrieval: {style: {fill: "#DFF3F2"; stroke: "#17807E"; stroke-width: 2; border-radius: 10; font-color: "#08403F"}}
  app: {style: {fill: "#FFFFFF"; stroke: "#1D1D1F"; stroke-width: 2; border-radius: 10; font-color: "#1D1D1F"}}
  danger: {style: {fill: "#FDE2E2"; stroke: "#C0392B"; stroke-width: 2; border-radius: 10; font-color: "#6B1A12"}}
  ok: {style: {fill: "#D9F2DF"; stroke: "#1F9D6B"; stroke-width: 2; border-radius: 10; font-color: "#0B4A31"}}
  warn: {style: {fill: "#FFF1C2"; stroke: "#C99A06"; stroke-width: 2; border-radius: 10; font-color: "#5C4300"}}
  store: {shape: cylinder; style: {fill: "#F4F4F6"; stroke: "#6B6B70"; stroke-width: 2; font-color: "#2B2B30"}}
  artifact: {shape: page; style: {fill: "#F2F4F8"; stroke: "#8A94AD"; stroke-width: 1; stroke-dash: 3; font-color: "#3A4256"}}
  decision: {shape: diamond; style: {fill: "#FFFFFF"; stroke: "#D8673B"; stroke-width: 2; font-color: "#6B2A0E"}}
  person: {shape: person; style: {fill: "#FFFFFF"; stroke: "#1D1D1F"; stroke-width: 2}}
  note: {shape: text; style: {font-color: "#6B6B70"; italic: true; font-size: 14}}
  group: {style: {fill: "#FAFAFB"; stroke: "#C9CBD3"; stroke-width: 1; border-radius: 14; font-color: "#4A4A55"; bold: true}}
  flow: {style: {stroke: "#4A4A55"; stroke-width: 2}}
  async: {style: {stroke: "#8A94AD"; stroke-width: 2; stroke-dash: 4}}
  fail: {style: {stroke: "#C0392B"; stroke-width: 2; stroke-dash: 3; font-color: "#C0392B"}}
}

